---
import Layout from '../layouts/Layout.astro';

const cardList = [
	{
		title: 'Cocktail jaune',
		content: 'This is a sample card.',
		buttonText: 'Commander',
		button2Text: 'Commander & ouvrir',
		image: '/drink-1.png',
		imageAlt: 'Cocktail jaune avec cerise et tranche d\'orange',
	},
	{
		title: "Cocktail a l'orange",
		content: 'This is another sample card.',
		buttonText: 'Commander',
		button2Text: 'Commander & ouvrir',
		image: '/drink-2.png',
		imageAlt: 'Cocktail jaune servi dans un verre bas',
	},
	{
		title: 'Thé glacé',
		content: 'This is a third sample card.',
		buttonText: 'Commander',
		button2Text: 'Commander & ouvrir',
		image: '/drink-3.png',
		imageAlt: 'Cocktail jaune avec tranche d\'orange et romarin',
	},

];
---

<Layout>
	<div class="cards">
		{cardList.map((card) => (
			<article class="card">
				<div class="card-content">
					<img class="card-image" src={card.image} alt={card.imageAlt} />
					<div class="card-copy">
						<h2>{card.title}</h2>
						<p>{card.content}</p>
					</div>
				</div>
				<div class="card-actions">
					<button type="button" class="button" data-action="order">{card.buttonText}</button>
					<button type="button" class="button" data-action="order-open">{card.button2Text}</button>
				</div>
			</article>
		))}
	</div>
	<div class="canopen">
		<button id="open-can" type="button" class="canbutton">Ouvrir la canette</button>
	</div>
	
	
	<div class="toast" data-toast role="status" aria-live="polite" aria-hidden="true">Commande envoyée</div>
</Layout>

<style>
	.cards {
		display: grid;
		gap: clamp(16px, 2vw, 28px);
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		margin: clamp(24px, 6vh, 64px) auto;
		max-width: 1280px;
		width: min(80vw, 1280px);
	}

	.card {
		background: #2e2e3a;
		border: 1px solid rgba(255, 202, 58, 0.24);
		border-radius: 14px;
		box-shadow: 0 16px 34px rgba(0, 0, 0, 0.2);
		display: flex;
		flex-direction: column;
		min-height: 560px;
		padding: clamp(20px, 3vw, 36px);
		transition: filter 180ms ease, transform 180ms ease;
	}

	.card-content {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.card-image {
		background: #9c6615;
		border-radius: 12px;
		display: block;
		height: clamp(280px, 30vw, 360px);
		margin-bottom: 20px;
		object-fit: contain;
		width: 100%;		
	}

	.card:hover {
		border-color: #ffca3a;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
		transform: translateY(-3px);
	}

	.card h2 {
		color: #fff;
		font-family: 'Trebuchet MS', sans-serif;
		font-size: 1.15rem;
		letter-spacing: 0.02em;
		margin: 0 0 12px;
	}

	.card p {
		color: rgba(255, 255, 255, 0.78);
		font-family: 'Trebuchet MS', sans-serif;
		font-size: 0.95rem;
		line-height: 1.6;
		margin: 0;
	}

	.card-actions {
		display: grid;
		gap: 10px;
		grid-template-columns: 1fr 1fr;
		margin-top: auto;
		padding-top: 20px;
		width: 100%;
	}

	.card-actions .button {
		background: #ffca3a;
		border: 1px solid #ffca3a;
		border-radius: 7px;
		color: #2e2e3a;
		cursor: pointer;
		font-family: 'Trebuchet MS', sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		padding: 10px 16px;
		text-align: center;
		transition: background 160ms ease, color 160ms ease, transform 160ms ease;
	}

	.card-actions .button:hover {
		background: #9c6615;
		border-color: #9c6615;
		color: #fff;
		transform: translateY(-1px);
	}

	.canopen {
		display: flex;
		justify-content: center;
		margin: 24px 0 48px;
		z-index: 10;
	}

	.canbutton {
		background: #ffca3a;
		border: 1px solid #ffca3a;
		border-radius: 7px;
		color: #2e2e3a;
		cursor: pointer;
		font-family: 'Trebuchet MS', sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		margin-top: auto;
		padding: 10px 16px;
		text-align: center;
		transition: background 160ms ease, color 160ms ease, transform 160ms ease;
		z-index: 10;
	}
	.canbutton:hover {
		background: #9c6615;
		border-color: #9c6615;
		color: #fff;
		transform: translateY(-1px);
	}

	.toast {
		background: #ffca3a;
		border: 1px solid #2e2e3a;
		border-radius: 8px;
		bottom: 24px;
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.28);
		color: #2e2e3a;
		font-family: 'Trebuchet MS', sans-serif;
		font-size: 0.9rem;
		font-weight: 700;
		left: 50%;
		opacity: 0;
		padding: 12px 18px;
		pointer-events: none;
		position: fixed;
		transform: translate(-50%, 16px);
		transition: opacity 180ms ease, transform 180ms ease;
		visibility: hidden;
		z-index: 10;
	}

	.toast.is-visible {
		opacity: 1;
		transform: translate(-50%, 0);
		visibility: visible;
	}

	@media (max-width: 1180px) {
		.cards {
			grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
			width: 92vw;
		}

		.card {
			min-height: 520px;
		}
	}

	@media (max-width: 600px) {
		.cards {
			grid-template-columns: 1fr;
			width: calc(100vw - 32px);
		}

		.card {
			min-height: 0;
			padding: 20px;
		}

		.card-content {
		}

		.card-image {
			height: clamp(260px, 85vw, 420px);
			margin-bottom: 16px;
		}

		.card-copy {
			min-width: 0;
		}

		.card h2 {
			font-size: 1rem;
			margin-bottom: 8px;
		}

		.card p {
			font-size: 0.85rem;
			margin: 0;
		}

		.card-actions {
			padding-top: 16px;
		}

		.card-actions .button {
			padding: 9px 12px;
		}
	}

	@media (max-width: 600px) and (orientation: landscape) {
		.cards {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.card {
			padding: 14px;
		}

		.card-content {
		}

		.card-image {
			height: 220px;
			margin-bottom: 12px;
		}

		.card h2 {
			font-size: 0.88rem;
		}

		.card p {
			font-size: 0.75rem;
			line-height: 1.35;
		}

		.card-actions {
			grid-template-columns: 1fr;
		}

		.card-actions .button {
			font-size: 0.72rem;
			padding: 7px 9px;
		}
	}
</style>
<script>
    const actionButtons = document.querySelectorAll<HTMLButtonElement>('.button[data-action]');

	const openCanButton = document.getElementById('open-can');
    const toast = document.querySelector('[data-toast]');
	let toastTimeout: ReturnType<typeof setTimeout> | undefined;
	type BluetoothCharacteristicLike = {
		writeValue(value: Uint8Array): Promise<void>;
	};
    
	function showToast(message: string) {
		if (!toast) return;
		toast.textContent = message;
		clearTimeout(toastTimeout);
		toast.classList.add('is-visible');
		toast.setAttribute('aria-hidden', 'false');
		toastTimeout = setTimeout(() => {
			toast.classList.remove('is-visible');
			toast.setAttribute('aria-hidden', 'true');
		}, 3000); // Augmenté à 3s pour avoir le temps de lire les retours de l'Arduino
	}

	let rxCharacteristic: BluetoothCharacteristicLike | null = null;

	document.addEventListener('bluetooth-connected', (event) => {
		const detail = (event as CustomEvent<{
			characteristic: BluetoothCharacteristicLike;
		}>).detail;
		rxCharacteristic = detail.characteristic;
		showToast('Bluetooth connecté !');
	});

	document.addEventListener('bluetooth-disconnected', () => {
		rxCharacteristic = null;
	});

	document.addEventListener('bluetooth-message', (event) => {
		const code = (event as CustomEvent<{ code: number }>).detail?.code;
		const boissons: Record<number, string> = {
			1: 'Bière rouge reçue',
			2: 'Bière bleue reçue',
			3: 'Bière jaune reçue',
		};
		if (code && boissons[code]) showToast(boissons[code]);
	});

	openCanButton?.addEventListener('click', async () => { // Open Can
		if (document.body.dataset.robotConnected !== 'true' || !rxCharacteristic) {
			alert('Vous devez connecter votre robot en Bluetooth avant d\'ouvrir la canette.');
			document.querySelector<HTMLButtonElement>('[data-connect]')?.click();
			return;
		}

		try {
			await rxCharacteristic.writeValue(new Uint8Array([4]));
			showToast('Détection du labyrinthe démarrée');
		} catch (error) {
			console.error("Erreur d'envoi:", error);
			alert("Erreur lors de l'envoi de la commande. La connexion est-elle perdue ?");
			document.body.dataset.robotConnected = 'false';
			rxCharacteristic = null;
		}
	});
    // Gérer les boutons des 3 cartes (Commander ou Commander & ouvrir)
    actionButtons.forEach((button) => {
		const card = button.closest('article');
		const cardIndex = card ? Array.from(card.parentElement?.children ?? []).indexOf(card) : -1;
		const action = button.dataset.action;

        button.addEventListener('click', async () => {
            if (!toast) return;
            
            // Vérification si l'Arduino est connecté
			if (document.body.dataset.robotConnected !== 'true' || !rxCharacteristic) {
                alert('Vous devez connecter votre robot en Bluetooth avant de commander.');
				document.querySelector<HTMLButtonElement>('[data-connect]')?.click();
                return;
            }

            try {
				if (cardIndex < 0) return;
				// 1-3 : commander uniquement
				// 5-7 : commander puis ouvrir
				const commande = action === 'order-open' ? cardIndex + 5 : cardIndex + 1;
                
				await rxCharacteristic.writeValue(new Uint8Array([commande]));
				showToast(`Commande ${commande} envoyée`);
                
                console.log(`Commande ${commande} envoyée !`);

            } catch (error) {
                console.error("Erreur d'envoi:", error);
                alert("Erreur lors de l'envoi de la commande. La connexion est-elle perdue ?");
				document.body.dataset.robotConnected = 'false';
				rxCharacteristic = null;
            }
        });
    });
</script>
